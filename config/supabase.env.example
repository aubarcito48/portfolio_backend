# Copy to ../.env.supabase (ignored by Git); fill locally, never paste secrets.
DJANGO_SECRET_KEY=replace-with-a-new-production-key
DJANGO_ALLOWED_HOSTS=replace-with-backend-hostname
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=postgres
POSTGRES_USER=replace-with-session-pooler-user
POSTGRES_PASSWORD=replace-with-rotated-database-password
POSTGRES_HOST=replace-with-host-from-supabase-connect
POSTGRES_PORT=5432
# require encrypts the connection; verify-full additionally checks the CA/host.
POSTGRES_SSLMODE=require
# Required only for verify-full: local path to the downloaded Supabase CA.
POSTGRES_SSLROOTCERT=
