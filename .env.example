DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Agregá un origen exacto solo si el Admin se sirve desde otro origen.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Variables de conexión local a PostgreSQL. Reemplazá estos valores localmente.
POSTGRES_DB=portfolio
POSTGRES_USER=replace-with-a-local-user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_DB=portfolio_test

# Aubar: solo backend. Nunca colocar estas variables en Angular.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Meta WhatsApp Cloud API: completar solo en el backend/Render.
# Mantener False hasta terminar la configuración de Meta.
WHATSAPP_ENABLED=False
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copiar la versión soportada indicada en API Setup de Meta (formato vNN.0).
WHATSAPP_GRAPH_VERSION=
# Opcional: destinatario argentino autorizado por Meta para pruebas, 54 + 10 dígitos.
# Dejar vacío en producción. Ver docs/WHATSAPP.md (error 131030).
WHATSAPP_TEST_RECIPIENT=
