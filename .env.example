DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Variables de conexión local a PostgreSQL. Reemplazá estos valores localmente.
POSTGRES_DB=portfolio
POSTGRES_USER=replace-with-a-local-user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_DB=portfolio_test
